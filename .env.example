# انسخ هذا الملف إلى .env.local وضع القيم الحقيقية فيه. لا ترفع .env.local إلى Git أبدًا.
# Copy to .env.local and fill in real values. Never commit .env.local.

# ── عام (تظهر في المتصفح — آمنة للنشر) ─────────────────────────────────────
# Supabase → Project Settings → API → Project URL
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co

# Supabase → Project Settings → API Keys → Publishable key (sb_publishable_...)
# (المشاريع القديمة: anon public key)
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxx

# رابط الموقع النهائي بدون / في النهاية (يستخدم للروابط الأساسية Canonical وsitemap)
NEXT_PUBLIC_SITE_URL=https://www.example.com

# ── سرية (على الخادم فقط — لا تضف لها NEXT_PUBLIC_ أبدًا) ─────────────────────
# Supabase → Project Settings → API Keys → Secret key (sb_secret_...)
# (المشاريع القديمة: service_role key)
# تُستخدم فقط لحفظ طلبات الحجز وإنشاء حساب المدير الأول.
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxx

# نص عشوائي طويل لتشفير عناوين IP عند الحد من الطلبات المزعجة.
# أنشئه بالأمر:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BOOKING_HASH_SALT=change-me-to-a-long-random-string

# اختياري: الحد الأقصى لطلبات الحجز من نفس الزائر خلال ساعة (الافتراضي 5)
# BOOKING_MAX_PER_HOUR=5
